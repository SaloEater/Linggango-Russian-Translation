      "text": "Добыча $(item)Сахара$() путём извлечения его из тростника",
      "recipe": "naturesaura:sugar"
    },
    {
      "type": "naturesaura:altar",
      "text": "Изготовление $(item)Огненного порошка$() из материалов Незера",
      "recipe": "naturesaura:blaze"
    },
    {
      "type": "naturesaura:altar",
      "text": "Создание $(item)Светопыли$() путём разрушения $(item)Светокамня$()",
      "recipe": "naturesaura:glowstone"
    },
    {
      "type": "naturesaura:altar",
      "text": "Изготовление $(item)Песка$() путём измельчения $(item)Булыжника$()",
      "recipe": "naturesaura:sand"
    },
    {
