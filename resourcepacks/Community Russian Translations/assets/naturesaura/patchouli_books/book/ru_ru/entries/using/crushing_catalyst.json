  "pages": [
    {
      "type": "text",
      "text": "$(l:using/altar)Природный алтарь$() может быть полезен для наполнения некоторых предметов силой $(aura), но его также можно использовать для $(thing)измельчения$() определённых предметов в различные формы.$(br)Этого можно достичь, создав $(item)Крошащийся катализатор$() и поместив его на любой из четырёх нижних блоков $(item)Золотого каменного кирпича$() вокруг алтаря, а затем поместив ингредиент на алтарь как обычно."
    },
    {
      "type": "naturesaura:tree_ritual",
      "text": "Создание $(item)Крошащегося катализатора$() с помощью $(l:practices/tree_ritual)Ритуала Леса$().",
      "recipe": "naturesaura:crushing_catalyst"
    },
    {
      "type": "naturesaura:altar",
      "text": "Создание $(item)Костной муки$() путём измельчения $(item)Костей$()",
      "recipe": "naturesaura:bone"
    },
    {
